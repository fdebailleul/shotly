{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "fr",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "offscreen",
    "unlimitedStorage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "__MSG_cmdCaptureVisible__"
    },
    "capture-full": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "__MSG_cmdCaptureFull__"
    },
    "capture-area": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "__MSG_cmdCaptureArea__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["editor.html", "screen-capture.html", "onboarding.html", "privacy.html", "history.html", "lib/tesseract-worker.min.js", "lib/tesseract-core-simd-lstm.wasm.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
